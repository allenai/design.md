{
  "name": "@allenai/design-system",
  "version": "0.1.0",
  "description": "DESIGN.md specs for Ai2's design system and the products that use it",
  "license": "Apache-2.0",
  "homepage": "https://github.com/allenai/design.md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allenai/design.md.git"
  },
  "keywords": [
    "design.md",
    "design-system",
    "design-tokens",
    "ai2"
  ],
  "type": "module",
  "files": [
    "strata",
    "asta",
    "olmo-earth",
    "earthranger",
    "docs/spec.md",
    "!earthranger/mockup-map-layers.html"
  ],
  "exports": {
    "./strata": "./strata/DESIGN.md",
    "./asta": "./asta/DESIGN.md",
    "./olmo-earth": "./olmo-earth/DESIGN.md",
    "./earthranger": "./earthranger/DESIGN.md",
    "./strata/voice": "./strata/VOICE.md",
    "./asta/voice": "./asta/VOICE.md",
    "./olmo-earth/voice": "./olmo-earth/VOICE.md",
    "./assets/*": "./strata/assets/*",
    "./package.json": "./package.json",
    "./strata/tokens.json": "./strata/tokens.json",
    "./asta/tokens.json": "./asta/tokens.json",
    "./olmo-earth/tokens.json": "./olmo-earth/tokens.json",
    "./earthranger/tokens.json": "./earthranger/tokens.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "compose:asta": "bun run scripts/compose.ts --base strata/DESIGN.md --overlay asta/DESIGN.src.md --out asta/DESIGN.md",
    "compose:olmo-earth": "bun run scripts/compose.ts --base strata/DESIGN.md --overlay olmo-earth/DESIGN.src.md --out olmo-earth/DESIGN.md",
    "compose": "bun run compose:asta && bun run compose:olmo-earth",
    "lint": "npx @google/design.md lint strata/DESIGN.md && npx @google/design.md lint asta/DESIGN.md && npx @google/design.md lint olmo-earth/DESIGN.md",
    "verify:composed": "bun run compose && git diff --exit-code -- '*/DESIGN.md'",
    "tokens:strata": "bun run scripts/emit-tokens.ts --spec strata/DESIGN.md --out strata/tokens.json",
    "tokens:asta": "bun run scripts/emit-tokens.ts --spec asta/DESIGN.md --out asta/tokens.json",
    "tokens:olmo-earth": "bun run scripts/emit-tokens.ts --spec olmo-earth/DESIGN.md --out olmo-earth/tokens.json",
    "tokens:earthranger": "bun run scripts/emit-tokens.ts --spec earthranger/DESIGN.md --out earthranger/tokens.json",
    "tokens": "bun run tokens:strata && bun run tokens:asta && bun run tokens:olmo-earth && bun run tokens:earthranger",
    "verify:tokens": "bun run tokens && git diff --exit-code -- '*/tokens.json'",
    "build": "bun run compose && bun run tokens"
  },
  "dependencies": {
    "yaml": "^2.7.1"
  }
}
