{
  "name": "@allenai/design-system",
  "version": "0.2.0",
  "description": "DESIGN.md specs for Ai2's design system and the products that use it",
  "license": "Apache-2.0",
  "homepage": "https://github.com/allenai/design.md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allenai/design.md.git"
  },
  "keywords": [
    "design.md",
    "design-system",
    "design-tokens",
    "ai2"
  ],
  "type": "module",
  "files": [
    "strata",
    "asta",
    "olmo-earth",
    "earthranger",
    "skylight",
    "docs/spec.md",
    "!earthranger/mockup-map-layers.html"
  ],
  "exports": {
    "./strata": "./strata/DESIGN.md",
    "./asta": "./asta/DESIGN.md",
    "./olmo-earth": "./olmo-earth/DESIGN.md",
    "./earthranger": "./earthranger/DESIGN.md",
    "./skylight": "./skylight/DESIGN.md",
    "./strata/voice": "./strata/VOICE.md",
    "./asta/voice": "./asta/VOICE.md",
    "./olmo-earth/voice": "./olmo-earth/VOICE.md",
    "./strata/assets/*": "./strata/assets/*",
    "./asta/assets/*": "./asta/assets/*",
    "./olmo-earth/assets/*": "./olmo-earth/assets/*",
    "./earthranger/assets/*": "./earthranger/assets/*",
    "./skylight/assets/*": "./skylight/assets/*",
    "./assets/*": "./strata/assets/*",
    "./package.json": "./package.json",
    "./olmo-earth/tokens.json": "./olmo-earth/tokens.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run compose && npm run tokens",
    "compose:asta": "node scripts/compose.ts --base strata/DESIGN.md --overlay asta/DESIGN.src.md --out asta/DESIGN.md",
    "compose:olmo-earth": "node scripts/compose.ts --base strata/DESIGN.md --overlay olmo-earth/DESIGN.src.md --out olmo-earth/DESIGN.md",
    "compose": "npm run compose:asta && npm run compose:olmo-earth",
    "tokens:olmo-earth": "node scripts/emit-tokens.ts --spec olmo-earth/DESIGN.md --out olmo-earth/tokens.json",
    "tokens": "npm run tokens:olmo-earth",
    "tokens:upstream": "npx @google/design.md@latest export --format dtcg olmo-earth/DESIGN.md > olmo-earth/tokens.json",
    "lint": "npx @google/design.md lint strata/DESIGN.md && npx @google/design.md lint asta/DESIGN.md && npx @google/design.md lint olmo-earth/DESIGN.md && npx @google/design.md lint earthranger/DESIGN.md && npx @google/design.md lint skylight/DESIGN.md"
  },
  "dependencies": {
    "yaml": "^2.7.1"
  }
}
